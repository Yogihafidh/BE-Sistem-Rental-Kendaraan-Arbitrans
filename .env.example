# ==============================================================================
# Arbitrans Vehicle Rental System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
# cp .env.example .env
#
# DO NOT commit real passwords, secret keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# APP_NAME: Descriptive application name for logging
APP_NAME="Arbitrans Vehicle Rental API"

# APP_ENV: Runtime environment [development | staging | production | test]
APP_ENV=development

# APP_PORT: Port number on which the HTTP server will listen
APP_PORT=8080

# HTTP Server Timeouts (accepts Go duration format: e.g., 10s, 1m, 30s)
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# DATABASE_URL: Full connection string (if provided, overrides individual DB_* settings)
# Example: postgres://postgres:postgres@localhost:5432/rental_db?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rental_db?sslmode=disable

# Discrete PostgreSQL connection parameters (used if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rental_db
DB_SSLMODE=disable

# Database Connection Pool Tuning
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_HEALTH_CHECK_PERIOD=1m

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify HMAC-SHA256 tokens.
# IMPORTANT: In production, must be at least 32 characters and cryptographically random.
JWT_SECRET=replace-with-a-very-long-and-secure-random-secret-key-32-chars

# JWT_EXPIRATION: Token validity duration (e.g., 24h, 72h, 30m)
JWT_EXPIRATION=24h

# JWT_ISSUER: Token issuer identifier
JWT_ISSUER=arbitrans-rental

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=vehicle-rental
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (or * for all in dev)
CORS_ALLOWED_ORIGINS=*

# CORS_ALLOWED_METHODS: Comma-separated list of HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# CORS_ALLOWED_HEADERS: Comma-separated list of accepted headers
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With

# CORS_EXPOSE_HEADERS: Comma-separated list of response headers exposed to browser JavaScript
CORS_EXPOSE_HEADERS=Content-Length

# CORS_ALLOW_CREDENTIALS: Allow sending cookies and authorization headers
CORS_ALLOW_CREDENTIALS=true

# CORS_MAX_AGE: Preflight cache duration
CORS_MAX_AGE=12h

